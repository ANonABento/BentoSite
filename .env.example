# bentosite Environment Variables
# Copy this file to .env.local and fill in your values

# =============================================================================
# CANONICAL SITE URL
# =============================================================================
#
# The public origin the site is served from, with no trailing slash, e.g.
#   NEXT_PUBLIC_SITE_URL=https://your-domain.com
#
# Set this in the Vercel project (all environments). It is the single source
# for every canonical <link>, og:url, og:image, sitemap.xml entry, robots.txt
# Host, and JSON-LD @id on the site.
#
# When unset, the build falls back to Vercel's own
# NEXT_PUBLIC_VERCEL_PROJECT_PRODUCTION_URL, then to http://localhost:3000.
# Never point it at a domain you do not control: a canonical tag naming
# someone else's site tells Google that theirs is the original.
NEXT_PUBLIC_SITE_URL=

# =============================================================================
# REQUIRED FOR CHAT FUNCTIONALITY
# =============================================================================

# Provider selection for grounded portfolio chat.
# Defaults to google when GOOGLE_GENERATIVE_AI_API_KEY is set,
# then openai when OPENAI_API_KEY is set, then local demo mode.
CHAT_PROVIDER=google

# Google Gemini API key. Recommended default provider for low-cost portfolio chat.
# Get a free key: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Gemini model override.
#
# Single-model pin (takes precedence over the chain, disables fallback):
#   GEMINI_CHAT_MODEL=gemini-2.5-flash
#
# Custom fallback chain (comma-separated; tried in order on 429/5xx/404):
#   GEMINI_CHAT_MODEL_CHAIN=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash
#
# Default chain (when neither var is set):
#   gemini-2.5-flash → gemini-2.0-flash → gemini-2.5-flash-lite → gemini-1.5-flash
GEMINI_CHAT_MODEL=
GEMINI_CHAT_MODEL_CHAIN=

# OpenAI API key for the alternate provider.
OPENAI_API_KEY=

# Optional OpenAI model override. Defaults to gpt-5.4-mini for cost/latency.
# Use a stronger model such as gpt-5.5 if you want deeper reasoning.
OPENAI_CHAT_MODEL=

# =============================================================================
# RATE LIMITING (optional, Upstash Redis)
# =============================================================================
#
# When both are set, /api/chat throttles to 10 requests per 60s per IP using
# a sliding window. When unset, the rate limiter is disabled (safe for local
# dev). Free Upstash account: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# =============================================================================
# NOTES
# =============================================================================
#
# Demo Mode:
#   If no configured provider key is set, the chat API will return
#   isDemoMode: true and provide deterministic responses from
#   src/content/portfolio.json.
