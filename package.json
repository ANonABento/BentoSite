{
  "name": "portfolio-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "predev": "npm run sync",
    "build": "next build",
    "prebuild": "npm run sync",
    "start": "next start",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "analyze": "ANALYZE=true next build",
    "sync": "npm run sync:projects && npm run sync:photos && npm run validate:content",
    "sync:projects": "node scripts/build-content.mjs",
    "sync:photos": "node scripts/sync-photos.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate-portfolio-schema": "node scripts/validate-content.mjs",
    "lighthouse": "lhci autorun",
    "size": "node scripts/check-bundle-size.mjs",
    "size:check": "node scripts/check-bundle-size.mjs --json"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "@types/matter-js": "^0.20.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "@use-gesture/react": "^10.3.1",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "d3-geo": "^3.1.1",
    "framer-motion": "^12.29.2",
    "lucide-react": "^0.563.0",
    "matter-js": "^0.20.0",
    "next": "^16.2.6",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.3.0",
    "three": "^0.181.2",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@lhci/cli": "^0.14.0",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.58.1",
    "@size-limit/preset-app": "^11.2.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-geo": "^3.1.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "babel-plugin-react-compiler": "^1.0.0",
    "baseline-browser-mapping": "^2.10.16",
    "eslint": "^9",
    "eslint-config-next": "^16.2.6",
    "jsdom": "^28.0.0",
    "size-limit": "^11.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  }
}
